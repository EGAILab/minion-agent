{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minion-agent.dev/conformance/agent-scenario.schema.json",
  "title": "Minion Agent agent conformance scenario",
  "type": "object",
  "required": [
    "name",
    "provider_script",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string"
        },
        "model": {
          "type": "string",
          "description": "Model name the agent requests. A name no adapter supplies exercises the eager side of the stream boundary."
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1
        },
        "next_turn_policy": {
          "enum": [
            "all",
            "one-at-a-time"
          ]
        },
        "next_step_policy": {
          "enum": [
            "all",
            "one-at-a-time"
          ]
        }
      }
    },
    "provider_script": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scriptedResponse"
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/toolStub"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "expect_events": {
      "type": "array"
    },
    "expect_messages": {
      "type": "array"
    },
    "expect_causes": {
      "type": "array",
      "items": {
        "type": "array"
      },
      "description": "Per completed turn, the origins of the inputs that caused it. Under claim-all one turn carries several, which a singular turn origin could not express."
    },
    "expect_assistant_stop_reasons": {
      "type": "array",
      "items": {
        "enum": [
          "stop",
          "length",
          "tool_use",
          "error",
          "aborted"
        ]
      },
      "description": "Stop reason of each assistant message reaching model history, in order."
    },
    "listeners": {
      "type": "array",
      "items": { "$ref": "#/$defs/listener" },
      "description": "Declarative listeners on the tools pipeline. Block and result transformation are listener behaviors; without this a scenario cannot express them."
    },
    "expect_tool_completion_order": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Tool call ids in the order their tools finished. Distinct from message order by design (design spec section 6)."
    },
    "expect_request_tools": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "string" } },
      "description": "Tool names offered to the model, per request in order. Pins what registration and withdrawal actually change."
    },
    "expect_error": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "UnknownModelError"
          ]
        },
        "message_contains": {
          "type": "string"
        }
      },
      "description": "The scenario is expected to raise. Only the eager side of the stream boundary does: once a stream is returned, nothing escapes iteration."
    }
  },
  "$defs": {
    "listener": {
      "type": "object",
      "required": ["event", "action"],
      "additionalProperties": false,
      "properties": {
        "event": { "enum": ["tools/pre-execute", "tools/post-execute"] },
        "action": {
          "enum": ["block", "narrow_arguments", "annotate_result", "abstain"]
        },
        "reason": { "type": "string" },
        "terminate": { "type": "boolean", "default": false },
        "arguments": { "type": "object" },
        "label": { "type": "string" },
        "only_tool": {
          "type": "string",
          "description": "Apply to calls naming this tool only. Without it a policy listener would have to be written per scenario."
        }
      }
    },
    "scriptedResponse": {
      "type": "object",
      "required": [
        "stop_reason"
      ],
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentBlock"
          }
        },
        "stop_reason": {
          "enum": [
            "stop",
            "length",
            "tool_use",
            "error",
            "aborted"
          ]
        },
        "error_message": {
          "type": "string"
        },
        "usage": {
          "type": "object"
        },
        "truncated": {
          "type": "boolean",
          "default": false,
          "description": "End the raw provider stream without a terminal chunk. The service must settle it as an error rather than raising."
        },
        "chunks_after_terminal": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Extra chunks a misbehaving provider emits after its terminal. The public stream must fuse and deliver none of them."
        }
      }
    },
    "contentBlock": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "text",
            "thinking",
            "image",
            "tool_call"
          ]
        },
        "text": {
          "type": "string"
        },
        "thinking": {
          "type": "string"
        },
        "mime_type": {
          "type": "string"
        },
        "data": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "object"
        }
      }
    },
    "toolStub": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result": {
          "type": "object"
        },
        "raises": {
          "type": "string"
        },
        "execution_mode": {
          "enum": [
            "parallel",
            "sequential"
          ]
        },
        "delay_ticks": {
          "type": "integer",
          "minimum": 0
        },
        "terminate": { "type": "boolean", "default": false },
        "adds_tools": { "type": "array", "items": { "type": "string" } }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "followup": {
          "$ref": "#/$defs/input"
        },
        "steer": {
          "$ref": "#/$defs/input"
        },
        "inject": {
          "$ref": "#/$defs/input"
        },
        "abort": {
          "type": "boolean"
        },
        "await_idle": {
          "type": "boolean"
        }
      }
    },
    "input": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "origin": {}
          }
        }
      ]
    }
  }
}

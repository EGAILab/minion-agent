{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Layer 13 built-in tool (WP-13.1 read/ls) canonical shape, discriminated by a top-level `builtin_tool` key -- another schema for conformance/agent/'s own directory, not a new canonical family. A runner builds `fixture` under a fresh temporary root, layers the optional scripted `provider` responses over the real local ctx.fs (recording every ctx.fs call), constructs the real built-in tool, and runs each case through the real Layer 06 execute pipeline. Paths are '/'-separated and relative to the fixture root. In expected text, `{abs:<relative path>}` stands for ctx.fs.absolute_path(<relative path>) on that root (`.` is the root itself).",
  "type": "object",
  "required": ["name", "family", "authority", "pi_revision", "requirements", "witnesses", "builtin_tool"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "family": { "const": "agent" },
    "authority": { "type": "string", "minLength": 1 },
    "pi_revision": { "type": "string", "minLength": 1 },
    "requirements": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^TOOL-0[0-9]{2}$" } },
    "witnesses": {
      "$comment": "The pi-parity-manifest `tests:` names this scenario closes.",
      "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }
    },
    "notes": { "type": "string" },
    "builtin_tool": {
      "type": "object",
      "required": ["tool", "cases"],
      "additionalProperties": false,
      "properties": {
        "tool": { "enum": ["read", "ls"] },
        "fixture": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
        "provider": { "$ref": "#/$defs/provider" },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "auto_resize_images": { "type": "boolean" },
            "model_supports_images": { "type": ["boolean", "null"], "$comment": "null: the tool is given no model knowledge at all" }
          }
        },
        "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "dir": { "const": true },
        "symlink": { "type": "string", "$comment": "link target, relative to the fixture root; may not exist" },
        "file": { "$ref": "#/$defs/content" }
      },
      "oneOf": [
        { "required": ["dir"] },
        { "required": ["symlink"] },
        { "required": ["file"] }
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "text": { "type": "string", "$comment": "written as UTF-8, byte for byte (no newline translation)" },
        "base64": { "type": "string" },
        "lines": {
          "type": "object", "required": ["count", "template"], "additionalProperties": false,
          "$comment": "`count` lines, each `template` with `{n}` replaced by the 1-based line number, joined by \\n, no trailing newline",
          "properties": { "count": { "type": "integer", "minimum": 1 }, "template": { "type": "string" } }
        },
        "repeat": {
          "type": "object", "required": ["unit", "times"], "additionalProperties": false,
          "properties": { "unit": { "type": "string", "minLength": 1 }, "times": { "type": "integer", "minimum": 1 } }
        },
        "fixture_file": { "type": "string", "$comment": "path under conformance/agent/fixtures/" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "without_exec_007": { "const": true, "$comment": "probe_dir_entry and list_dir_raw return not_supported (a provider lacking EXEC-007)" },
        "probe_dir_entry": { "type": "array", "items": { "$ref": "#/$defs/scriptedProbe" } },
        "list_dir_raw": { "type": "array", "items": { "$ref": "#/$defs/scriptedList" } },
        "read_binary_file": { "type": "array", "items": { "$ref": "#/$defs/scriptedError" } },
        "file_info": { "type": "array", "items": { "$ref": "#/$defs/scriptedError" } }
      }
    },
    "fsErrorCode": { "enum": ["aborted", "not_found", "permission_denied", "not_directory", "is_directory", "invalid", "not_supported", "unknown"] },
    "scriptedError": {
      "type": "object", "required": ["path", "error"], "additionalProperties": false,
      "properties": { "path": { "type": "string" }, "error": { "$ref": "#/$defs/fsErrorCode" } }
    },
    "scriptedProbe": {
      "type": "object", "required": ["path"], "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "error": { "$ref": "#/$defs/fsErrorCode" },
        "kind": { "enum": ["file", "directory", "symlink_to_file", "symlink_to_directory", "other"] }
      },
      "oneOf": [{ "required": ["error"] }, { "required": ["kind"] }]
    },
    "scriptedList": {
      "type": "object", "required": ["path"], "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "error": { "$ref": "#/$defs/fsErrorCode" },
        "names": { "type": "array", "items": { "type": "string" }, "$comment": "raw enumeration order, verbatim" }
      },
      "oneOf": [{ "required": ["error"] }, { "required": ["names"] }]
    },
    "case": {
      "type": "object",
      "required": ["arguments", "expect"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "signal": { "const": "pre_aborted" },
        "arguments": { "type": "object" },
        "expect": { "$ref": "#/$defs/expectation" }
      }
    },
    "expectation": {
      "type": "object",
      "required": ["is_error"],
      "additionalProperties": false,
      "oneOf": [{ "required": ["text"] }, { "required": ["text_sha256", "text_tail"] }],
      "properties": {
        "is_error": { "type": "boolean" },
        "text": { "type": "string", "$comment": "content_blocks[0].text, exact" },
        "text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "$comment": "sha256 of content_blocks[0].text's UTF-8 bytes, for texts too long to inline" },
        "text_tail": { "type": "string", "$comment": "the exact end of content_blocks[0].text (with text_sha256)" },
        "image": {
          "oneOf": [
            { "type": "null", "$comment": "no content_blocks[1]" },
            {
              "type": "object", "required": ["mime_type", "sha256", "bytes"], "additionalProperties": false,
              "properties": { "mime_type": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "bytes": { "type": "integer", "minimum": 0 } }
            }
          ]
        },
        "details": {
          "type": "object",
          "$comment": "the tool's own details keys, exact; {} means none (Layer 06: a host may default absent details to an empty mapping)"
        },
        "fs_calls": {
          "type": "array", "items": { "type": "string" },
          "$comment": "every ctx.fs call in order, as '<operation> <relative path>'"
        },
        "probed_entries": {
          "type": "array", "items": { "type": "string" },
          "$comment": "relative paths passed to probe_dir_entry, in order"
        }
      }
    }
  }
}

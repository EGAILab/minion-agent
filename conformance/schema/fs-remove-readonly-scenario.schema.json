{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minion-agent/conformance/schema/fs-remove-readonly-scenario.schema.json",
  "title": "L12-D005 remove / read-only attribute scenario",
  "description": "One ctx.fs remove call over a natively prepared fixture (minion-agent#188, #126). The runner prepares the fixture natively, calls the binding's real remove, and reports its Result, the entries left under the case cwd and each external path's state. It never implements removal itself. Expectations are pinned Pi's (NodeExecutionEnv under Node v22.15.1), generated by assurance/layers/data/l12-d005/gen.",
  "type": "object",
  "required": ["name", "authority", "pi_revision", "requirements", "platforms", "fs_remove"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "authority": { "type": "string", "minLength": 1 },
    "pi_revision": { "const": "b7bb00b936dbe21b8e160b3e89efdec361846699" },
    "requirements": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "platforms": {
      "description": "Platforms the case runs on. A case outside the runner's platform is an explicit platform skip, never a pass.",
      "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["linux", "win32"] }
    },
    "notes": { "type": "string" },
    "fs_remove": {
      "type": "object",
      "required": ["fixture", "remove", "expect", "expect_left"],
      "additionalProperties": false,
      "properties": {
        "fixture": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fixture_step" } },
        "remove": {
          "type": "object", "required": ["path", "recursive"], "additionalProperties": false,
          "properties": { "path": { "$ref": "#/$defs/rel" }, "recursive": { "type": "boolean" } }
        },
        "expect": {
          "oneOf": [
            { "type": "object", "required": ["ok"], "additionalProperties": false, "properties": { "ok": { "const": true } } },
            {
              "type": "object", "required": ["error", "path"], "additionalProperties": false,
              "properties": {
                "error": { "enum": ["not_found", "permission_denied", "not_directory", "is_directory", "invalid", "aborted", "not_supported", "unknown"] },
                "path": { "description": "Path components of the error's path relative to the case cwd.", "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
              }
            }
          ]
        },
        "expect_left": {
          "description": "Every entry left under the case cwd after the call, sorted depth-first by name: a directory ends in '/', a symlink in '@'.",
          "type": "array", "items": { "type": "string" }
        },
        "expect_external": {
          "type": "array",
          "items": {
            "type": "object", "required": ["path", "exists"], "additionalProperties": false,
            "properties": {
              "path": { "$ref": "#/$defs/rel" },
              "exists": { "type": "boolean" },
              "readonly": { "type": "boolean", "description": "Windows: FILE_ATTRIBUTE_READONLY; POSIX: no write bit set." },
              "text": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "rel": { "description": "A path relative to the case cwd: /-separated segments, none of them . or ..", "type": "string", "pattern": "^(?![.]{1,2}(/|$))[A-Za-z0-9._-]+(/(?![.]{1,2}(/|$))[A-Za-z0-9._-]+)*$" },
    "fixture_step": {
      "description": "Native fixture preparation. readonly: Windows sets FILE_ATTRIBUTE_READONLY; POSIX clears every write bit (0444 file, 0555 directory). readonly_link: Windows attribute on the symlink itself. deny_delete: Windows ACL deny DELETE on the path and DELETE_CHILD on its parent. deny_write_attributes: Windows ACL deny WRITE_ATTRIBUTES. The runner restores ACLs and attributes after the case.",
      "oneOf": [
        { "type": "object", "required": ["file"], "additionalProperties": false, "properties": { "file": { "$ref": "#/$defs/rel" }, "text": { "type": "string" } } },
        { "type": "object", "required": ["dir"], "additionalProperties": false, "properties": { "dir": { "$ref": "#/$defs/rel" } } },
        { "type": "object", "required": ["readonly"], "additionalProperties": false, "properties": { "readonly": { "$ref": "#/$defs/rel" } } },
        { "type": "object", "required": ["readonly_link"], "additionalProperties": false, "properties": { "readonly_link": { "$ref": "#/$defs/rel" } } },
        { "type": "object", "required": ["symlink", "to", "kind"], "additionalProperties": false, "properties": { "symlink": { "$ref": "#/$defs/rel" }, "to": { "$ref": "#/$defs/rel" }, "kind": { "enum": ["file", "dir"] } } },
        { "type": "object", "required": ["deny_delete"], "additionalProperties": false, "properties": { "deny_delete": { "$ref": "#/$defs/rel" } } },
        { "type": "object", "required": ["deny_write_attributes"], "additionalProperties": false, "properties": { "deny_write_attributes": { "$ref": "#/$defs/rel" } } }
      ]
    }
  }
}

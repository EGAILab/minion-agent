{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Cross-layer delta L0206-D001 (K1; AI-003 / TOOL-003): ECMAScript own-property enumeration order of tool-argument objects. Scenarios live in conformance/agent/key-order/*.json, discriminated by a top-level `key_order` key. A runner builds `arguments` (an INSERTION SEQUENCE {\"$o\": [[key, value], ...]}, a key may repeat) by plain assignment in that order, constructs ONE ToolCall with it, and OBSERVES the recursive key enumeration -- never reorders on the pipeline's behalf -- at: `raw` (the constructed ToolCall.arguments, which is also the tools/execution-start payload), `replay` (an AssistantMessage holding the call appended to a fresh session log and replayed), `hook` (the tools/pre-execute listener, before any mutation), `execute`. The tool has `schema` as its parameters (\"edit\": the built-in edit tool's schema) and, for `prepare: edit`, edit's prepare_arguments. `mutate`: the listener assigns these [key, value] pairs IN PLACE on the arguments object (pinned Pi's beforeToolCall). `replace`: the listener returns this insertion sequence as REPLACEMENT arguments (a Minion mapping; Pi's hook cannot replace). OBSERVATION GRAMMAR: {\"o\": [[key, observation], ...]} an object in enumeration order; {\"a\": [...]} an array; a JSON scalar is itself. `provider_text` is the provider argument text pinned Pi decoded (evidence; Minion has no certified raw decoder yet). Expectations: pinned Pi (spec/llm.md, L0206-D001). L0206-D001-R001/R002: `program` is a mutation program the pre-execute listener runs IN PLACE on the arguments object (set/push/insert/get by target handle; `as` names the object a value builds, or the object got; `ref` places an existing handle again), so retained references and objects appended to arrays are exercised; `observe_second` adds `second`, a later listener's view after the program. `key` may be any string.",
  "type": "object",
  "required": [
    "name",
    "family",
    "authority",
    "pi_revision",
    "requirements",
    "witnesses",
    "key_order"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "const": "agent"
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "pi_revision": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]+-[0-9]{3}$"
      }
    },
    "witnesses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    },
    "key_order": {
      "type": "object",
      "required": [
        "cases"
      ],
      "additionalProperties": false,
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/case"
          }
        }
      }
    }
  },
  "$defs": {
    "scalar": {
      "type": [
        "string",
        "integer",
        "boolean",
        "null"
      ]
    },
    "value": {
      "oneOf": [
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "$ref": "#/$defs/insertion"
        }
      ]
    },
    "pair": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/value"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "insertion": {
      "type": "object",
      "required": [
        "$o"
      ],
      "additionalProperties": false,
      "properties": {
        "$o": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pair"
          }
        }
      }
    },
    "observation": {
      "oneOf": [
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "type": "object",
          "required": [
            "a"
          ],
          "additionalProperties": false,
          "properties": {
            "a": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/observation"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "o"
          ],
          "additionalProperties": false,
          "properties": {
            "o": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/observation"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "provider_text",
        "arguments",
        "schema",
        "expect"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provider_text": {
          "type": "string"
        },
        "arguments": {
          "$ref": "#/$defs/insertion"
        },
        "schema": {
          "oneOf": [
            {
              "const": "edit"
            },
            {
              "type": "object"
            }
          ]
        },
        "prepare": {
          "const": "edit"
        },
        "mutate": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pair"
          }
        },
        "replace": {
          "$ref": "#/$defs/insertion"
        },
        "expect": {
          "type": "object",
          "required": [
            "raw",
            "replay",
            "hook",
            "execute"
          ],
          "additionalProperties": false,
          "properties": {
            "raw": {
              "$ref": "#/$defs/observation"
            },
            "replay": {
              "$ref": "#/$defs/observation"
            },
            "hook": {
              "$ref": "#/$defs/observation"
            },
            "execute": {
              "$ref": "#/$defs/observation"
            },
            "second": {
              "$ref": "#/$defs/observation"
            }
          }
        },
        "program": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/op"
          }
        },
        "observe_second": {
          "const": true
        }
      },
      "not": {
        "required": [
          "mutate",
          "replace"
        ]
      },
      "dependentRequired": {
        "observe_second": [
          "program"
        ]
      }
    },
    "op": {
      "type": "object",
      "required": [
        "op",
        "target",
        "key"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "set",
            "push",
            "insert",
            "get"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "as": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "get"
              }
            }
          },
          "then": {
            "required": [
              "as"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "ref"
                  ]
                }
              ]
            }
          },
          "else": {
            "oneOf": [
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "ref"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "insert"
              }
            }
          },
          "then": {
            "required": [
              "index"
            ]
          },
          "else": {
            "not": {
              "required": [
                "index"
              ]
            }
          }
        }
      ]
    }
  }
}

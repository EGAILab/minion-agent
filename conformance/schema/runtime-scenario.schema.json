{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minion-agent.dev/conformance/runtime-scenario.schema.json",
  "title": "Minion Agent runtime conformance scenario",
  "type": "object",
  "required": [
    "name",
    "plugins",
    "steps",
    "expect_trace"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/plugin"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "expect_trace": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/traceEntry"
      }
    },
    "expect_result": {},
    "expect_error": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ServiceConflictError",
            "InactiveFiberError",
            "ServiceNotFoundError",
            "EventModeError",
            "WaterfallError"
          ]
        },
        "message_contains": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "serviceName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "plugin": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "inject": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serviceName"
          }
        },
        "provides": {
          "oneOf": [
            {
              "$ref": "#/$defs/serviceName"
            },
            {
              "type": "object",
              "required": [
                "name"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "#/$defs/serviceName"
                },
                "visible": {
                  "type": "boolean",
                  "default": true,
                  "description": "When false, registers a `check` predicate that always returns false, so the service is registered (service_provided still fires, the provider can still reach ACTIVE) but never resolves to an injector. Expresses the check-predicate half of RT-007 -- ACTIVE alone is necessary but not sufficient for visibility."
                }
              }
            }
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "scope_parent": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "object"
        },
        "fails": {
          "type": "boolean",
          "default": false
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "listeners": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "event",
              "action",
              "tag"
            ],
            "additionalProperties": false,
            "properties": {
              "event": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "enum": [
                  "delegate",
                  "short_circuit",
                  "observe",
                  "raise",
                  "transform",
                  "delegate_twice",
                  "echo_args"
                ]
              },
              "replacement": {},
              "tag": {
                "type": "string",
                "minLength": 1
              },
              "returns": {}
            }
          }
        },
        "during_load": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "description": "Steps executed inside this plugin's body, before it returns. The only way to express a dependency disappearing mid-load, which is what distinguishes a stale loading attempt from an ordinary unload."
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "mount": {
          "type": "string"
        },
        "unmount": {
          "type": "string"
        },
        "dispose_scope": {
          "type": "string"
        },
        "attempt_effect": {
          "type": "object",
          "required": [
            "plugin"
          ],
          "additionalProperties": false,
          "properties": {
            "plugin": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "Attempt ctx.effect() on an already-mounted plugin's context from outside its own apply() body, at whatever state the fiber is currently in. The only way to express RT-015: an effect attempted after the fiber has left Loading/Active must raise, and this step is how a scenario reaches for the context after mounting has already returned control to the top level."
        },
        "dispatch": {
          "type": "object",
          "required": [
            "event",
            "mode"
          ],
          "additionalProperties": false,
          "properties": {
            "event": {
              "type": "string",
              "minLength": 1
            },
            "mode": {
              "enum": [
                "emit",
                "parallel",
                "serial",
                "waterfall"
              ]
            },
            "args": {
              "type": "array"
            },
            "scope": {
              "type": "string"
            },
            "terminal": {},
            "terminal_from_args": {
              "type": "boolean",
              "default": false,
              "description": "Compute the terminal from the current arguments rather than using a fixed value. Required to express a transformation chain whose last listener delegates, where a fixed terminal would discard the transformed value."
            }
          }
        }
      }
    },
    "traceEntry": {
      "type": "object",
      "required": [
        "event"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "enum": [
            "fiber_state",
            "effect_created",
            "effect_disposed",
            "listener_entered",
            "service_provided",
            "service_revoked",
            "scope_disposed"
          ]
        },
        "scope": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "state": {
          "enum": [
            "pending",
            "loading",
            "active",
            "failed",
            "unloading",
            "disposed"
          ]
        },
        "label": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "service": {
          "$ref": "#/$defs/serviceName"
        }
      }
    }
  }
}

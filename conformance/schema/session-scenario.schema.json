{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minion-agent.dev/conformance/session-scenario.schema.json",
  "title": "Minion Agent session conformance scenario",
  "type": "object",
  "required": [
    "name",
    "steps",
    "expect_messages"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "expect_messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "user",
              "assistant",
              "tool_result"
            ]
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "expect_assistant_details": {
      "type": "array",
      "items": { "$ref": "#/$defs/assistantDetail" },
      "description": "The full round-tripped AssistantMessage shape for each assistant message in derivation order -- proves the log's encode/decode carries every field, not just text (design spec section 4/5)."
    },
    "expect_tool_result_details": {
      "type": "array",
      "items": { "$ref": "#/$defs/toolResultDetail" },
      "description": "The full round-tripped ToolResultMessage shape for each tool-result message in derivation order."
    },
    "expect_reconstructed_header": {
      "type": "object",
      "required": ["components"],
      "additionalProperties": false,
      "properties": {
        "components": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "tools": {
          "type": "array",
          "items": { "$ref": "#/$defs/toolStub" }
        }
      },
      "description": "Reconstructing the most recent record_header step must reproduce exactly what was given -- the property the design's own invariant checks (design spec section 5): the model saw what the log says."
    },
    "expect_artifact_count": {
      "type": "integer",
      "minimum": 0,
      "description": "The shared ArtifactStore's final size. Proves content-addressed reuse: a stable component recorded across many steps costs one artifact, not one per step."
    },
    "expect_event_kinds": {
      "type": "array",
      "items": { "type": "string" },
      "description": "The real committed event-kind strings, in log order, read directly from the Session's own stored events -- never derived by the runner. Directly observes Session-owned operation-kind identity (session/forked, session/reset, session/compaction, request/header, plus surface kinds), the one thing compact()/derive() using matching wrong spellings internally could not expose by themselves (delta finding B)."
    },
    "expect_error": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "message_contains": {
          "type": "string"
        }
      },
      "description": "The scenario is expected to raise while executing its steps. The runner calls the real Session API and reports the real exception type/message; it never pre-checks conditions itself (delta finding D)."
    },
    "surface_kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(?:/[a-z][a-z0-9_-]*)*$"
      },
      "description": "Event names this session treats as surface, beyond the core three. An open namespace is not an open surface: a plugin event derives only when the deployment declares it here."
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "append": {
          "type": "object",
          "required": ["role"],
          "additionalProperties": false,
          "properties": {
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(?:/[a-z][a-z0-9_-]*)*$",
              "description": "user, assistant, or tool_result for core kinds; any validated event name for a plugin-declared kind. The name string is the identity."
            },
            "text": {
              "type": "string",
              "description": "Shorthand for a single text content block. Ignored when `content` is given."
            },
            "content": {
              "type": "array",
              "items": { "$ref": "#/$defs/contentBlock" },
              "description": "Full content-block list, for scenarios that need signature/thinking/tool-call fields `text` cannot express."
            },
            "timestamp": {
              "type": "number",
              "description": "Shared across UserMessage/AssistantMessage/ToolResultMessage. Defaults to 1 when omitted."
            },
            "usage": { "$ref": "#/$defs/usage" },
            "provider": { "type": "string", "description": "Assistant-only. Defaults to `mock` when omitted." },
            "model": { "type": "string", "description": "Assistant-only. Defaults to `mock-1` when omitted." },
            "error_message": { "type": "string", "description": "Assistant-only." },
            "api": { "type": "string" },
            "response_model": { "type": "string" },
            "response_id": { "type": "string" },
            "diagnostics": {
              "type": "array",
              "items": { "$ref": "#/$defs/diagnostic" }
            },
            "deferred": { "$ref": "#/$defs/deferredHandle" },
            "raw_stop_reason": { "type": "string" },
            "end_turn": { "type": "boolean" },
            "stop_reason": {
              "enum": ["stop", "length", "tool_use", "error", "aborted", "deferred"],
              "description": "Assistant-only. Defaults to `stop` when omitted."
            },
            "tool_call_id": { "type": "string", "description": "Tool-result-only. Defaults to `t1` when omitted." },
            "tool_name": { "type": "string" },
            "details": {},
            "added_tool_names": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "allOf": [
            {
              "if": {
                "not": {
                  "required": ["role"],
                  "properties": { "role": { "const": "assistant" } }
                }
              },
              "then": {
                "properties": {
                  "provider": false, "model": false, "error_message": false,
                  "api": false, "response_model": false, "response_id": false,
                  "diagnostics": false, "deferred": false, "raw_stop_reason": false,
                  "end_turn": false, "stop_reason": false
                }
              }
            },
            {
              "if": {
                "not": {
                  "required": ["role"],
                  "properties": { "role": { "const": "tool_result" } }
                }
              },
              "then": {
                "properties": {
                  "tool_call_id": false, "tool_name": false, "details": false,
                  "added_tool_names": false
                }
              }
            },
            {
              "if": {
                "not": {
                  "required": ["role"],
                  "properties": { "role": { "enum": ["assistant", "tool_result"] } }
                }
              },
              "then": {
                "properties": { "usage": false }
              }
            },
            {
              "if": {
                "required": ["role"],
                "properties": { "role": { "const": "assistant" } }
              },
              "then": {
                "properties": {
                  "content": {
                    "items": { "properties": { "type": { "enum": ["text", "thinking", "tool_call"] } } }
                  }
                }
              },
              "else": {
                "properties": {
                  "content": {
                    "items": { "properties": { "type": { "enum": ["text", "image"] } } }
                  }
                }
              },
              "description": "Role-restricted content variants, matching Pi's frozen per-role content union exactly (packages/ai/src/types.ts: UserMessage/ToolResultMessage carry TextContent|ImageContent, AssistantMessage carries TextContent|ThinkingContent|ToolCall) -- delta finding C. A user/tool_result/plugin append cannot carry a thinking or tool_call block; an assistant append cannot carry an image block."
            },
            {
              "if": {
                "required": ["role"],
                "properties": { "role": { "const": "tool_result" } }
              },
              "then": {
                "required": ["tool_name"]
              },
              "description": "ToolResultMessage.tool_name is required, matching Pi's non-optional toolName (packages/ai/src/types.ts) -- delta finding A."
            }
          ],
          "description": "Role-discriminated: fields outside a role's real message constructor are schema-invalid, not silently ignored (Rust review item 3)."
        },
        "record_header": {
          "type": "object",
          "required": ["components", "model"],
          "additionalProperties": false,
          "properties": {
            "components": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "model": { "type": "string" },
            "tools": {
              "type": "array",
              "items": { "$ref": "#/$defs/toolStub" }
            }
          },
          "description": "Records a request header through the real content-addressed store (design spec section 5)."
        },
        "fork": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "at": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "reset": {
          "type": "object",
          "additionalProperties": false
        },
        "compact": {
          "type": "object",
          "required": [
            "summary"
          ],
          "additionalProperties": false,
          "properties": {
            "summary": {
              "type": "string"
            },
            "keep": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "derive": {
          "type": "object",
          "additionalProperties": false
        }
      }
    },
    "contentBlock": {
      "description": "Discriminated by `type` -- each variant is closed to exactly its own real dataclass fields (Rust review item 4).",
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "text"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "text" },
            "text": { "type": "string" },
            "text_signature": { "type": ["string", "null"] }
          }
        },
        {
          "type": "object",
          "required": ["type", "thinking"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "thinking" },
            "thinking": { "type": "string" },
            "thinking_signature": { "type": ["string", "null"] },
            "redacted": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["type", "mime_type"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "image" },
            "mime_type": { "type": "string" },
            "data": { "type": "string" },
            "reference": { "type": "string" }
          },
          "oneOf": [
            { "required": ["data"], "not": { "required": ["reference"] } },
            { "required": ["reference"], "not": { "required": ["data"] } }
          ],
          "description": "Exactly one of data/reference, matching ImageBlock.__post_init__'s enforced exclusive-or."
        },
        {
          "type": "object",
          "required": ["type", "id", "name", "arguments"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "tool_call" },
            "id": { "type": "string" },
            "name": { "type": "string" },
            "arguments": { "type": "object" },
            "thought_signature": { "type": ["string", "null"] },
            "namespace": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": { "type": "number" },
        "output": { "type": "number" },
        "cache_read": { "type": "number" },
        "cache_write": { "type": "number" },
        "total": { "type": "number" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": { "type": "integer" },
        "output": { "type": "integer" },
        "cache_read": { "type": "integer" },
        "cache_write": { "type": "integer" },
        "cache_write_1h": { "type": ["integer", "null"] },
        "reasoning": { "type": ["integer", "null"] },
        "total_tokens": { "type": "integer" },
        "cost": { "$ref": "#/$defs/cost" }
      }
    },
    "diagnosticError": {
      "type": "object",
      "required": ["message"],
      "additionalProperties": false,
      "properties": {
        "message": { "type": "string" },
        "name": { "type": ["string", "null"] },
        "stack": { "type": ["string", "null"] },
        "code": { "oneOf": [{ "type": "string" }, { "type": "number" }, { "type": "null" }] }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["type", "timestamp"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "timestamp": { "type": "number" },
        "error": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/diagnosticError" }]
        },
        "details": {
          "oneOf": [{ "type": "null" }, { "type": "object" }]
        }
      }
    },
    "deferredHandle": {
      "type": "object",
      "required": ["provider", "model_id", "api", "id"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string" },
        "model_id": { "type": "string" },
        "api": { "type": "string" },
        "id": { "type": "string" },
        "expires_at": { "type": ["number", "null"] },
        "poll_after_ms": { "type": ["number", "null"] },
        "data": {}
      }
    },
    "toolStub": {
      "type": "object",
      "required": ["name", "description", "parameters"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "parameters": { "type": "object" }
      }
    },
    "assistantDetail": {
      "type": "object",
      "required": [
        "content", "stop_reason", "usage", "provider", "model", "timestamp", "error_message",
        "api", "response_model", "response_id", "diagnostics", "deferred", "raw_stop_reason",
        "end_turn"
      ],
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/contentBlock" },
              { "properties": { "type": { "enum": ["text", "thinking", "tool_call"] } } }
            ]
          },
          "description": "AssistantMessage carries TextContent|ThinkingContent|ToolCall only (packages/ai/src/types.ts) -- delta finding C."
        },
        "stop_reason": {
          "enum": ["stop", "length", "tool_use", "error", "aborted", "deferred"]
        },
        "usage": { "$ref": "#/$defs/usage" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "timestamp": { "type": "number" },
        "error_message": { "type": ["string", "null"] },
        "api": { "type": "string" },
        "response_model": { "type": ["string", "null"] },
        "response_id": { "type": ["string", "null"] },
        "diagnostics": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
          ]
        },
        "deferred": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/deferredHandle" }]
        },
        "raw_stop_reason": { "type": ["string", "null"] },
        "end_turn": { "type": ["boolean", "null"] }
      },
      "description": "The complete round-tripped AssistantMessage shape this DSL asserts -- every field the frozen Layer-02 vocabulary carries, all scriptable through the canonical append input and observed from the real reconstructed message (Rust review item 1)."
    },
    "toolResultDetail": {
      "type": "object",
      "required": [
        "tool_call_id", "content", "timestamp", "is_error", "tool_name", "details", "usage",
        "added_tool_names"
      ],
      "additionalProperties": false,
      "properties": {
        "tool_call_id": { "type": "string" },
        "content": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/contentBlock" },
              { "properties": { "type": { "enum": ["text", "image"] } } }
            ]
          },
          "description": "ToolResultMessage carries TextContent|ImageContent only (packages/ai/src/types.ts) -- delta finding C."
        },
        "timestamp": { "type": "number" },
        "is_error": { "type": "boolean" },
        "tool_name": { "type": "string" },
        "details": {},
        "usage": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/usage" }]
        },
        "added_tool_names": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "items": { "type": "string" } }
          ]
        }
      },
      "description": "The complete round-tripped ToolResultMessage shape this DSL asserts, including tool_call_id and timestamp (Rust review item 2)."
    }
  }
}

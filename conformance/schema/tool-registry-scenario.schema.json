{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Layer 05 (Tool model + registry) canonical shape, discriminated by a top-level `tool_registry` key -- a third schema for conformance/agent/'s own directory (alongside the unified and transform shapes), not a fourth canonical family: scenarios here exercise the real ToolRegistry/Context/scope seam directly, not a full agent-loop turn.",
  "type": "object",
  "required": ["name", "family", "authority", "pi_revision", "tool_registry", "expect"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "family": { "const": "agent" },
    "authority": { "type": "string", "minLength": 1 },
    "pi_revision": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" },
    "tool_registry": {
      "type": "object",
      "required": ["plugins", "steps", "queries"],
      "additionalProperties": false,
      "properties": {
        "plugins": {
          "type": "array",
          "items": { "$ref": "#/$defs/pluginEntry" }
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/step" }
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/query" }
        }
      }
    },
    "expect": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/queryExpectation" }
    }
  },
  "$defs": {
    "pluginEntry": {
      "type": "object",
      "required": ["id", "tools"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "scope_parent": { "type": "string", "minLength": 1 },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/toolInput" }
        }
      }
    },
    "toolInput": {
      "type": "object",
      "required": ["name", "description", "label"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "label": { "type": "string", "minLength": 1 },
        "parameters": {
          "oneOf": [{ "type": "object" }, { "type": "null" }]
        },
        "constrained_sampling": { "$ref": "#/$defs/constrainedSamplingInput" }
      }
    },
    "constrainedSamplingInput": {
      "oneOf": [
        { "type": "null" },
        { "const": false },
        {
          "type": "object",
          "required": ["type", "strict"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "json_schema" },
            "strict": { "enum": ["prefer", "require"] }
          }
        },
        {
          "type": "object",
          "required": ["type", "variants"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "grammar" },
            "variants": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "mount": { "type": "string", "minLength": 1 },
        "unmount": { "type": "string", "minLength": 1 },
        "withdraw": { "type": "string", "minLength": 1 },
        "dispose_scope": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "resolve": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "queryExpectation": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "names": {
          "type": "array",
          "items": { "type": "string" }
        },
        "schemas": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedSchema" }
        },
        "resolve": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/expectedResolve" }
        }
      }
    },
    "expectedSchema": {
      "type": "object",
      "required": ["name", "description", "parameters", "constrained_sampling"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "parameters": { "type": "object" },
        "constrained_sampling": { "$ref": "#/$defs/constrainedSamplingInput" }
      }
    },
    "expectedResolve": {
      "oneOf": [
        {
          "type": "object",
          "required": ["found"],
          "additionalProperties": false,
          "properties": {
            "found": { "const": false }
          }
        },
        {
          "type": "object",
          "required": ["found", "label"],
          "additionalProperties": false,
          "properties": {
            "found": { "const": true },
            "label": { "type": "string" }
          }
        }
      ]
    }
  }
}

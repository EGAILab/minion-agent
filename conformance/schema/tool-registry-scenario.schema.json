{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Layer 05 (Tool model + registry) canonical shape, discriminated by a top-level `tool_registry` key -- a third schema for conformance/agent/'s own directory (alongside the unified and transform shapes), not a fourth canonical family: scenarios here exercise the real ToolRegistry/Context/scope seam directly, not a full agent-loop turn.",
  "type": "object",
  "required": ["name", "family", "authority", "pi_revision", "tool_registry", "expect"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "family": { "const": "agent" },
    "authority": { "type": "string", "minLength": 1 },
    "pi_revision": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" },
    "tool_registry": {
      "type": "object",
      "required": ["plugins", "steps", "queries"],
      "additionalProperties": false,
      "properties": {
        "plugins": {
          "type": "array",
          "items": { "$ref": "#/$defs/pluginEntry" }
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/step" }
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/query" }
        }
      }
    },
    "expect": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/queryExpectation" }
    }
  },
  "$defs": {
    "pluginEntry": {
      "type": "object",
      "required": ["id", "tools"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "scope_parent": { "type": "string", "minLength": 1 },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/toolInput" }
        }
      }
    },
    "toolInput": {
      "type": "object",
      "required": ["name", "description", "label", "parameters"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "label": { "type": "string", "minLength": 1 },
        "parameters": {
          "$comment": "Object-valued JSON Schema only (L05-R005) -- pinned Pi's Tool.parameters is required, never null/omitted; a parameterless tool must write the empty-object schema explicitly ({type: object, properties: {}}), not rely on a missing/null shorthand.",
          "type": "object"
        },
        "constrained_sampling": { "$ref": "#/$defs/constrainedSamplingInput" }
      }
    },
    "constrainedSamplingInput": {
      "$comment": "The four Pi-defined states are exactly: field omitted (absent), false, json_schema config, grammar config. Explicit null is not a fifth alias for absent (L05-R006) -- a scenario that means \"absent\" omits this key entirely; if present, it must be one of the three non-null variants below.",
      "oneOf": [
        { "const": false },
        {
          "type": "object",
          "required": ["type", "strict"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "json_schema" },
            "strict": { "enum": ["prefer", "require"] }
          }
        },
        {
          "type": "object",
          "required": ["type", "variants"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "grammar" },
            "variants": {
              "$comment": "Closed to pinned Pi's own GrammarFormat = \"openai_lark\" | \"openai_regex\" (L05-R001) -- not an open string-keyed map. No minProperties: pinned Pi's GrammarVariants = Partial<Record<GrammarFormat, string>> statically permits {} at the Tool-model boundary; Pi's own runtime rejection of an empty grammar selection happens at provider request-construction time (packages/ai/src/api/constrained-sampling.ts::resolveGrammarConstrainedSampling), which is Real Providers/assurance Layer 11 territory, not Layer 05.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "openai_lark": { "type": "string" },
                "openai_regex": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "mount": { "type": "string", "minLength": 1 },
        "unmount": { "type": "string", "minLength": 1 },
        "withdraw": { "type": "string", "minLength": 1 },
        "dispose_scope": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "resolve": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "queryExpectation": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "names": {
          "type": "array",
          "items": { "type": "string" }
        },
        "schemas": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedSchema" }
        },
        "resolve": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/expectedResolve" }
        }
      }
    },
    "expectedSchema": {
      "type": "object",
      "required": ["name", "description", "parameters", "constrained_sampling"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "parameters": { "type": "object" },
        "constrained_sampling": { "$ref": "#/$defs/constrainedSamplingOutput" }
      }
    },
    "constrainedSamplingOutput": {
      "$comment": "The observed ToolSchema.as_json() projection, not canonical toolInput -- these are different positions (L05-R006). Here 'absent' is the required key's explicit null value, matching the project's established optional-field convention (as_json()'s own docstring, e.g. response_model in spec/llm.md): the projected field is always present, null when there is no constrained-sampling preference. This is distinct from toolInput's own absent state, which OMITS the key entirely and, per L05-R006, does not accept an explicit null as an alias.",
      "oneOf": [
        { "type": "null" },
        { "const": false },
        {
          "type": "object",
          "required": ["type", "strict"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "json_schema" },
            "strict": { "enum": ["prefer", "require"] }
          }
        },
        {
          "type": "object",
          "required": ["type", "variants"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "grammar" },
            "variants": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "openai_lark": { "type": "string" },
                "openai_regex": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "expectedResolve": {
      "oneOf": [
        {
          "type": "object",
          "required": ["found"],
          "additionalProperties": false,
          "properties": {
            "found": { "const": false }
          }
        },
        {
          "type": "object",
          "required": ["found", "label"],
          "additionalProperties": false,
          "properties": {
            "found": { "const": true },
            "label": { "type": "string" }
          }
        }
      ]
    }
  }
}
